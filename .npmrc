# npm ayarları da sürüm gibi projeye çivilenir — `.nvmrc` ve `rust-toolchain.toml` ile
# aynı disiplin: yerel ve CI aynı dosyayı okur.
#
# `legacy-peer-deps` neden AÇIKÇA kapalı: makinenin genel `~/.npmrc`'sinde bu ayar açıksa
# `npm install` akran bağımlılıklarını hiç çözmeden bir kilit dosyası üretir. Bu projede
# tam olarak öyle oldu — `fdir` köke çıktı, isteğe bağlı akranı `picomatch ^3 || ^4`
# kökteki `picomatch@2.3.2`'ye düştü ve kilit dosyası geçersiz bir kenarla yazıldı.
# Yerelde aynı ayar doğrulamayı da kapattığı için hata HİÇ görünmedi; CI'da o ayar
# olmadığı için `npm ci` iki faz boyunca `EUSAGE` ile düştü.
#
# Buradaki satır makinenin ayarını projeye sızmaktan alıkoyar. Diğer anahtarlar
# (özel kayıt defterleri, jetonlar) etkilenmez — npm yapılandırmayı anahtar bazında
# birleştirir, dosya bazında değil.
legacy-peer-deps=false
